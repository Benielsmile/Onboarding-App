# ============================================================================
# PIGA STUDIO — Onboarding App environment
# Copiez ce fichier vers .env puis remplissez les valeurs.
# En déploiement Vercel, déclarez ces variables dans Project Settings > Environment Variables.
# ============================================================================

# --- Base de données PostgreSQL (Neon) — OBLIGATOIRE ---
DATABASE_URL="postgresql://user:password@host/db"
# Variante poolée (recommandée en serverless / Vercel)
DATABASE_URL_POOLED="postgresql://user:password@host/db?sslmode=require"

# --- Administration (console admin, identité Direction unique) ---
# Ne committez JAMAIS les vraies valeurs ici (elles restent dans .env / Vercel env).
ADMIN_EMAIL="direction@votre-domaine.example"
ADMIN_PASSWORD="<choisir un mot de passe unique de 20+ caractères, généré par gestionnaire>"

# --- Cryptographie (tickets AES-256-GCM & URLs signées preuves) ---
ARSENAL_SECRET="CHANGEME_SECRET_PRODUCTION_LONG"

# --- Notifications push serveur (W3C Web Push / VAPID) ---
# Générées via : npm run generate:vapid (clé PUBLIQUE servie au navigateur,
# clé PRIVÉE serveur uniquement). Sans ces variables, les push sont désactivés.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:direction@piga.cd"

# --- Serveur local (ignoré sur Vercel) ---
PORT=3000
